# ── NTU webmail (IMAP) ─────────────────────────────────────────────
# 台大信箱有幾種不同的後端，請先確認你的帳號屬於哪一種：
#
#   1) NTU Mail（自架，帳號如 b12345678@ntu.edu.tw）
#        IMAP_HOST=mail.ntu.edu.tw
#        IMAP_PORT=993
#
#   2) 系所信箱（如 csie / ee / management，各系自架）
#        IMAP_HOST=mail.csie.ntu.edu.tw   ← 換成你系上的
#        IMAP_PORT=993
#
#   3) 若你的 ntu.edu.tw 是掛在 Google Workspace 底下
#        IMAP_HOST=imap.gmail.com
#        IMAP_PORT=993
#        IMAP_PASS 要用「應用程式密碼」，不是登入密碼
#
# 不確定的話，去 webmail 網頁介面的「設定 → 收信軟體 / IMAP」看一眼。

IMAP_HOST=mail.ntu.edu.tw
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_account@ntu.edu.tw
IMAP_PASS=

# 伺服器憑證有問題時才改成 false（會降低安全性，先試 true）
IMAP_TLS_REJECT_UNAUTHORIZED=true

# ── 要同步哪些遠端資料夾（逗號分隔）────────────────────────────────
# 先跑 `npm run folders` 看伺服器上實際的名稱再填
SYNC_FOLDERS=INBOX

# ── 本機收件匣 ─────────────────────────────────────────────────────
# 信件會以 .eml 原始檔存在這裡，附件另外拆出來
MAILBOX_DIR=./data/mailbox

# 每個資料夾單次同步最多抓幾封（0 = 不限）
SYNC_LIMIT=0

# 只抓這個日期之後的信（YYYY-MM-DD，留空 = 全部）
SYNC_SINCE=

# ── 瀏覽介面 ───────────────────────────────────────────────────────
# 127.0.0.1  只有這台電腦連得到（預設，搭配 `tailscale serve` 用這個）
# tailscale  自動綁定到你的 Tailscale IP（100.x.x.x），手機可直連，
#            但是 http:// 不是安全來源，service worker 不會啟動，
#            也就沒有離線快取。想要完整 PWA 請看 README 的 tailscale serve。
# 0.0.0.0    同網段的任何人都連得到 —— 咖啡廳 wifi 上別這樣設
HTTP_HOST=127.0.0.1
HTTP_PORT=8025

# ── 手機通知：Web Push（選用，免費無上限）──────────────────────────
# 由你這台電腦直接推通知到手機，不經過任何第三方帳號，也沒有額度限制。
# 通知內容是端對端加密的，中繼的 Apple／Google 伺服器看不到主旨。
#
# 設定步驟：
#   1. npm run push:keys   ← 產生一組金鑰，貼到下面
#   2. 確認 PWA 已經透過 tailscale serve 的 https 網址加到主畫面
#      （Web Push 需要安全來源；iOS 還必須先加到主畫面才給開通知）
#   3. 在 App 裡按「開啟通知」，允許權限
#
# 換掉金鑰的話，手機要重新開啟一次通知。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:你的信箱@ntu.edu.tw

# ── LINE 通知（選用）─────────────────────────────────────────────
# 每次同步後推一則摘要到 LINE。純推播，不需要公開網址或 webhook。
#
# 設定步驟：
#   1. https://developers.line.biz/console/ 建立 Provider
#   2. 在裡面建立一個 Messaging API channel
#   3. Messaging API 分頁 → Channel access token (long-lived) → Issue
#   4. 用手機掃同一頁的 QR code 加 bot 好友
#   5. Basic settings 分頁最底下 → Your user ID → 複製到 LINE_TO
#      （是 U 開頭那一長串，不是你的 LINE ID）
#   6. 跑 `npm run line:test` 確認手機收得到
#
# 留空就不會推播。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# 推播內容：預設只有寄件者和主旨，信件內文不經過 LINE 的伺服器。
# 設成 true 會連前幾行摘要一起推。
LINE_INCLUDE_SNIPPET=false

# 卡片上「開啟收件匣」按鈕的網址（選用）。
# 填你的 tailscale serve 網址，例如 https://your-mac.tailnet-xxxx.ts.net/
LINE_OPEN_URL=
